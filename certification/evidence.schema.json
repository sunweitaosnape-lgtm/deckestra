{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckestra.invalid/schemas/certification-evidence-v1.json",
  "title": "Deckestra frozen blind certification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_sha256",
    "suite",
    "runtime",
    "reviewers",
    "cases"
  ],
  "properties": {
    "schema": {"const": "deckestra-certification-evidence/v1"},
    "policy_sha256": {"$ref": "#/$defs/hash"},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "frozen",
        "frozen_at",
        "case_count",
        "case_ids_sha256",
        "suite_sha256"
      ],
      "properties": {
        "profile": {"const": "zh-cn-tech-brief-15-v1"},
        "frozen": {"const": true},
        "frozen_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "case_count": {"const": 1000},
        "case_ids_sha256": {"$ref": "#/$defs/hash"},
        "suite_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_tree_sha256",
        "evaluated_commit",
        "model_id",
        "host_version",
        "python_version",
        "os_id",
        "locale",
        "timezone",
        "dependency_lock_sha256",
        "font_bundle_sha256"
      ],
      "properties": {
        "skill_tree_sha256": {"$ref": "#/$defs/hash"},
        "evaluated_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "model_id": {"$ref": "#/$defs/runtimeToken"},
        "host_version": {"$ref": "#/$defs/runtimeToken"},
        "python_version": {"$ref": "#/$defs/runtimeToken"},
        "os_id": {"$ref": "#/$defs/runtimeToken"},
        "locale": {"$ref": "#/$defs/runtimeToken"},
        "timezone": {"$ref": "#/$defs/runtimeToken"},
        "dependency_lock_sha256": {"$ref": "#/$defs/hash"},
        "font_bundle_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "independence_attestation_sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^R[0-9]{3,6}$"},
          "independence_attestation_sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1000,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableHash": {
      "anyOf": [
        {"$ref": "#/$defs/hash"},
        {"type": "null"}
      ]
    },
    "runtimeToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+:-]{0,119}$"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "generator_id",
        "manual_fallback",
        "page_count",
        "repair_budget",
        "layout_trace_status",
        "svg_quality_errors",
        "svg_quality_warnings",
        "required_native_objects",
        "present_native_objects",
        "postflight_status",
        "ir_sha256",
        "layout_trace_sha256",
        "pptx_sha256",
        "postflight_sha256",
        "run_receipt_sha256"
      ],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "generator_id": {"type": "string", "pattern": "^G[0-9]{3,6}$"},
        "manual_fallback": {"type": "boolean"},
        "page_count": {"type": "integer", "minimum": 0, "maximum": 15},
        "repair_budget": {"type": "integer", "minimum": 0, "maximum": 2},
        "layout_trace_status": {"enum": ["passed", "failed", "not-run"]},
        "svg_quality_errors": {"type": "integer", "minimum": 0},
        "svg_quality_warnings": {"type": "integer", "minimum": 0},
        "required_native_objects": {"type": "integer", "minimum": 0},
        "present_native_objects": {"type": "integer", "minimum": 0},
        "postflight_status": {
          "enum": ["passed", "passed-with-warnings", "failed", "not-run"]
        },
        "ir_sha256": {"$ref": "#/$defs/hash"},
        "layout_trace_sha256": {"$ref": "#/$defs/nullableHash"},
        "pptx_sha256": {"$ref": "#/$defs/nullableHash"},
        "postflight_sha256": {"$ref": "#/$defs/nullableHash"},
        "run_receipt_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "independent",
        "render_sha256",
        "criteria",
        "verdict",
        "receipt_sha256"
      ],
      "properties": {
        "reviewer_id": {"type": "string", "pattern": "^R[0-9]{3,6}$"},
        "independent": {"type": "boolean"},
        "render_sha256": {"$ref": "#/$defs/nullableHash"},
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_fidelity",
            "information_completeness",
            "narrative_coherence",
            "chinese_language_quality",
            "no_overlap_or_clipping",
            "readable_hierarchy",
            "visual_consistency",
            "native_editability"
          ],
          "properties": {
            "content_fidelity": {"type": "boolean"},
            "information_completeness": {"type": "boolean"},
            "narrative_coherence": {"type": "boolean"},
            "chinese_language_quality": {"type": "boolean"},
            "no_overlap_or_clipping": {"type": "boolean"},
            "readable_hierarchy": {"type": "boolean"},
            "visual_consistency": {"type": "boolean"},
            "native_editability": {"type": "boolean"}
          }
        },
        "verdict": {"enum": ["pass", "fail"]},
        "receipt_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "render_sha256", "reviews"],
      "properties": {
        "id": {"type": "string", "pattern": "^P[0-9]{2}$"},
        "state": {"enum": ["rendered", "missing"]},
        "render_sha256": {"$ref": "#/$defs/nullableHash"},
        "reviews": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/review"}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_sha256",
        "constraints_sha256",
        "generation",
        "pages"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^C[0-9]{4}$"},
        "input_sha256": {"$ref": "#/$defs/hash"},
        "constraints_sha256": {"$ref": "#/$defs/hash"},
        "generation": {"$ref": "#/$defs/generation"},
        "pages": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": {"$ref": "#/$defs/page"}
        }
      }
    }
  }
}
