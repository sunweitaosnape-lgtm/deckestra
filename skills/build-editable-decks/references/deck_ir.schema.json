{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckestra.invalid/schema/deckestra-ir-v1.json",
  "title": "Deckestra typed deck IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pages"],
  "properties": {
    "schema": {"const": "deckestra-ir/v1"},
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "number", "minimum": 800, "maximum": 3840},
        "height": {"type": "number", "minimum": 600, "maximum": 2160}
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {"$ref": "#/$defs/color"},
        "panel": {"$ref": "#/$defs/color"},
        "primary": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "text": {"$ref": "#/$defs/color"},
        "muted": {"$ref": "#/$defs/color"},
        "title_font": {"type": "string", "minLength": 1, "maxLength": 120},
        "body_font": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {"$ref": "#/$defs/sourceId"},
          "kind": {"enum": ["input", "user", "calculated", "public", "licensed-asset"]},
          "locator": {"type": "string", "maxLength": 1200},
          "license": {"type": "string", "maxLength": 240}
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "sourceId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "sourceIds": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceId"}
    },
    "contentItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 220},
        "body": {"type": "string", "minLength": 1, "maxLength": 1800},
        "bullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "value": {"type": "string", "minLength": 1, "maxLength": 80},
        "label": {"type": "string", "minLength": 1, "maxLength": 180},
        "detail": {"type": "string", "minLength": 1, "maxLength": 500},
        "source_ids": {"$ref": "#/$defs/sourceIds"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "layout", "title"],
      "properties": {
        "id": {"type": "string", "pattern": "^P[0-9]{2,3}$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
        "layout": {"enum": ["cover", "section", "statement", "title-body", "two-column", "cards", "metrics", "process", "table", "bar-chart", "quote", "closing"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "subtitle": {"type": "string", "maxLength": 900},
        "eyebrow": {"type": "string", "maxLength": 160},
        "body": {"type": "string", "maxLength": 4000},
        "bullets": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 600}},
        "columns": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/contentItem"}},
        "cards": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/contentItem"}},
        "metrics": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/contentItem"}},
        "steps": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"$ref": "#/$defs/contentItem"}},
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns", "rows"],
          "properties": {
            "columns": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
            "rows": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 300}}},
            "source_ids": {"$ref": "#/$defs/sourceIds"}
          }
        },
        "chart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["categories", "values"],
          "properties": {
            "categories": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
            "values": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "number", "minimum": 0}},
            "series_label": {"type": "string", "maxLength": 160},
            "source_ids": {"$ref": "#/$defs/sourceIds"}
          }
        },
        "quote": {"type": "string", "maxLength": 1800},
        "attribution": {"type": "string", "maxLength": 240},
        "source_ids": {"$ref": "#/$defs/sourceIds"}
      }
    }
  }
}
